void CAN_Start(void)
{
    if (HAL_CAN_Start(&hcan1) != HAL_OK)
        Error_Handler();

    if (HAL_CAN_ActivateNotification(&hcan1, CAN_IT_RX_FIFO0_MSG_PENDING) != HAL_OK)
        Error_Handler();
}

HAL_StatusTypeDef CAN_Send(uint32_t id, uint8_t *data, uint8_t len)
{
    CAN_TxHeaderTypeDef txHeader;
    uint32_t mailbox;

    txHeader.StdId = id;
    txHeader.IDE = CAN_ID_STD;
    txHeader.RTR = CAN_RTR_DATA;
    txHeader.DLC = len;

    HAL_StatusTypeDef status = HAL_CAN_AddTxMessage(&hcan1, &txHeader, data, &mailbox);

    if (status != HAL_OK)
    {
        uint32_t err = HAL_CAN_GetError(&hcan1);
        printf("CAN TX Error: 0x%lX\n", err);
    }

    return status;
}
void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan)
{
	 if (HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0, &rxHeader, rxData) != HAL_OK)
	    {
	        uint32_t err = HAL_CAN_GetError(hcan);
	        printf("CAN RX Error: 0x%lX\n", err);
	        return;
	    }


	 HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
	    printf("RX ID: 0x%03X DLC:%d Data: ", rxHeader.StdId, rxHeader.DLC);
	    printf("\r\n");
	    for (int i = 0; i < rxHeader.DLC; i++)
	        printf(" %02X", rxData[i]);
	    printf("\n");
}

void CAN_CheckErrors(void)
{
    uint32_t err = HAL_CAN_GetError(&hcan1);

    if (err == HAL_CAN_ERROR_NONE) return;

    if (err & HAL_CAN_ERROR_EWG) printf("Error Warning\r\n");
    if (err & HAL_CAN_ERROR_EPV) printf("Error Passive\r\n");
    if (err & HAL_CAN_ERROR_BOF) printf("Bus Off\r\n");
    if (err & HAL_CAN_ERROR_STF) printf("Stuff Error\r\n");
    if (err & HAL_CAN_ERROR_FOR) printf("Form Error\r\n");
    if (err & HAL_CAN_ERROR_ACK) printf("ACK Error\r\n");
    if (err & HAL_CAN_ERROR_CRC) printf("CRC Error\r\n");
}

